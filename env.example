# ============================================
# Video Streaming Platform - Environment Variables
# ============================================
# Copy this file to .env and update values as needed
# For Docker Compose: Variables are already set in docker-compose.yml
# For individual service runs: Set these variables in your environment

# ============================================
# MongoDB Configuration
# ============================================
# Default: mongodb://localhost:27017
# For Docker Compose: mongodb://mongodb:27017
MONGODB_URI=mongodb://localhost:27017

# ============================================
# User Account Management Service (Port 3001)
# ============================================
PORT=3001
MONGODB_URI=mongodb://localhost:27017/videostream_users
JWT_SECRET=your-secret-key-change-in-production-use-strong-random-key
LOGGING_SERVICE_URL=http://localhost:3006

# ============================================
# Storage Management Service (Port 3002)
# ============================================
PORT=3002
MONGODB_URI=mongodb://localhost:27017/videostream_storage
STORAGE_DIR=./uploads
LOGGING_SERVICE_URL=http://localhost:3006

# ============================================
# Usage Monitoring Service (Port 3003)
# ============================================
PORT=3003
MONGODB_URI=mongodb://localhost:27017/videostream_usage
LOGGING_SERVICE_URL=http://localhost:3006

# ============================================
# Model Service (Port 3004)
# ============================================
PORT=3004
USER_SERVICE_URL=http://localhost:3001
STORAGE_SERVICE_URL=http://localhost:3002
USAGE_SERVICE_URL=http://localhost:3003
LOGGING_SERVICE_URL=http://localhost:3006

# ============================================
# Controller Service (Port 3005)
# ============================================
PORT=3005
USER_SERVICE_URL=http://localhost:3001
MODEL_SERVICE_URL=http://localhost:3004
STORAGE_SERVICE_URL=http://localhost:3002
LOGGING_SERVICE_URL=http://localhost:3006
TEMP_UPLOAD_DIR=./temp_uploads
JWT_SECRET=your-secret-key-change-in-production-use-strong-random-key
FRONTEND_URL=http://localhost:3000

# Google Cloud Storage Configuration
GCS_BUCKET_NAME=videostream-videos
GCS_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ============================================
# Logging Service (Port 3006)
# ============================================
PORT=3006
MONGODB_URI=mongodb://localhost:27017/videostream_logs

# ============================================
# View Generator Service (Port 3000)
# ============================================
PORT=3000
CONTROLLER_SERVICE_URL=http://localhost:3005

