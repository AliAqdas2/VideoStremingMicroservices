# ============================================
# Video Streaming Platform - Environment Variables
# ============================================
# Copy this file to .env and update values as needed
# For Docker Compose: Variables are already set in docker-compose.yml
# For individual service runs: Set these variables in your environment

# ============================================
# MongoDB Configuration
# ============================================
# Default: mongodb://localhost:27017
# For Docker Compose: mongodb://mongodb:27017
MONGODB_URI=mongodb+srv://admin-ali:admin-ali@cluster0.bjolxbl.mongodb.net/?appName=Cluster0



# ============================================
# Storage Management Service (Port 3002)
# ============================================
PORT=3002
STORAGE_DIR=./uploads
LOGGING_SERVICE_URL=http://localhost:3006

